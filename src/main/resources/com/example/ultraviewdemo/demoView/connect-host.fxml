<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ultraviewdemo.client.ConnectHostController" style="-fx-background-color: linear-gradient(to bottom, #102c57, #0b2440); -fx-text-fill: #e5efff; -fx-font-family: 'Segoe UI','Arial',sans-serif;">
    <center>
        <VBox spacing="24.0" alignment="TOP_CENTER">
            <VBox spacing="10.0" alignment="CENTER">
                <HBox spacing="12.0" alignment="CENTER">
                    <Label text="🖥" style="-fx-font-size: 28px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 10, 0.3, 0, 2);" />
                    <Label text="UltraView Remote" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e5efff;" />
                </HBox>
                <Label text="Secure remote desktop control with end-to-end encryption" style="-fx-text-fill: #c7d9ff; -fx-font-size: 14px;" />
                <HBox spacing="8.0" alignment="CENTER">
                    <Label text=" AES-256 " style="-fx-background-color: rgba(40,160,120,0.25); -fx-text-fill: #a5ffd6; -fx-padding: 5 10; -fx-background-radius: 14; -fx-font-size: 12px;" />
                    <Label text=" Low Latency " style="-fx-background-color: rgba(255,200,60,0.2); -fx-text-fill: #ffe8a3; -fx-padding: 5 10; -fx-background-radius: 14; -fx-font-size: 12px;" />
                    <Label text=" Global Access " style="-fx-background-color: rgba(80,140,255,0.25); -fx-text-fill: #cfe0ff; -fx-padding: 5 10; -fx-background-radius: 14; -fx-font-size: 12px;" />
                </HBox>
            </VBox>
            <HBox spacing="8.0" alignment="CENTER">
                <Label text="Server" style="-fx-text-fill: #cfe0ff; -fx-opacity: 0.9;" />
                <TextField fx:id="serverField" promptText="localhost" prefWidth="240.0" style="-fx-background-radius: 10; -fx-padding: 6 10; -fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 10; -fx-text-fill: #e9f2ff;" />
            </HBox>
            <VBox spacing="16.0" alignment="CENTER" maxWidth="760.0">
                <VBox spacing="12.0" alignment="TOP_LEFT" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 16;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="Your ID" style="-fx-text-fill: #deebff; -fx-font-weight: 600; -fx-font-size: 14px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text=" Ready " style="-fx-background-color: rgba(40,200,120,0.35); -fx-text-fill: #d7ffe8; -fx-padding: 4 10; -fx-background-radius: 14; -fx-font-size: 12px;" />
                    </HBox>

                    <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 12; -fx-padding: 12;">
                        <TextField fx:id="hostIdField" editable="false" promptText="000 000 000" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #e9f2ff; -fx-font-size: 36px; -fx-font-weight: 700; -fx-alignment: CENTER_LEFT;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="copyBtn" text="Copy" style="-fx-background-color: #3b7cff; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 6 14; -fx-font-weight: 600;" />
                    </HBox>

                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label text="Password" style="-fx-text-fill: #cfe0ff; -fx-font-size: 12px; -fx-opacity: 0.9;" />
                        <TextField fx:id="hostPasswordField" editable="false" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 8 12; -fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 10; -fx-text-fill: #e9f2ff;" />
                        <Button fx:id="regenerateBtn" text="Regenerate" style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: #e5efff; -fx-background-radius: 10; -fx-padding: 8 12; -fx-font-size: 12px; -fx-font-weight: 600;" />
                    </HBox>

                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label text=" Your computer is protected. You'll be notified when someone tries to connect." style="-fx-text-fill: #b9c9ee; -fx-font-size: 12px;" />
                    </HBox>

                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <Button fx:id="stopBtn" disable="true" text="Stop" style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: #e5efff; -fx-background-radius: 10; -fx-padding: 8 14; -fx-font-size: 13px;" />
                        <Button fx:id="startBtn" text="Start Sharing" style="-fx-background-color: #3b7cff; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 16; -fx-font-weight: 700; -fx-font-size: 13px;" />
                        <Label fx:id="statusLabel" text="Idle" style="-fx-text-fill: #b9c9ee; -fx-font-size: 12px;" />
                    </HBox>
                </VBox>
                <HBox alignment="CENTER" spacing="8.0">
                    <Region prefHeight="1.0" style="-fx-background-color: rgba(255,255,255,0.08);" HBox.hgrow="ALWAYS" />
                    <Label text="OR" style="-fx-text-fill: #aabce6; -fx-padding: 2 12; -fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 6;" />
                    <Region prefHeight="1.0" style="-fx-background-color: rgba(255,255,255,0.08);" HBox.hgrow="ALWAYS" />
                </HBox>
                <VBox spacing="14.0" alignment="TOP_LEFT" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 16;">
                    <Label text="Connect to Partner" style="-fx-text-fill: #deebff; -fx-font-weight: 600; -fx-font-size: 14px;" />

                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <TextField fx:id="connectHostIdField" promptText="Enter Partner ID (e.g., 123 456 789)" HBox.hgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10 14; -fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 10; -fx-text-fill: #e9f2ff;" />
                        <HBox spacing="6.0">
                            <PasswordField fx:id="connectPasswordField" promptText="Password" prefWidth="160.0" style="-fx-background-radius: 10; -fx-padding: 10 12; -fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 10; -fx-text-fill: #e9f2ff;" />
                            <Button fx:id="connectBtn" text="Connect ➜" style="-fx-background-color: #3b7cff; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 16; -fx-font-weight: 700;" />
                        </HBox>
                    </HBox>
                    <Label fx:id="connectErrorLabel" textFill="#ffb4b4" style="-fx-font-size: 12px;" />

                    <HBox spacing="10.0">
                        <Label text=" Full Control " style="-fx-background-color: rgba(80,140,255,0.25); -fx-text-fill: #d6e4ff; -fx-padding: 8 12; -fx-background-radius: 10; -fx-font-size: 12px;" />
                        <Label text=" Encrypted " style="-fx-background-color: rgba(40,160,120,0.25); -fx-text-fill: #c9ffe6; -fx-padding: 8 12; -fx-background-radius: 10; -fx-font-size: 12px;" />
                    </HBox>
                </VBox>
            </VBox>
            <VBox spacing="6.0" visible="false" managed="false">
                <Label text="IPs" />
                <TextArea fx:id="ipTextArea" />
            </VBox>
        </VBox>
    </center>
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
</BorderPane>


