<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootBox" alignment="TOP_CENTER" spacing="5.0"
      style="-fx-background-color: #f9fafb; -fx-background-radius: 15 0 0 15; -fx-border-radius: 15 0 0 15; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 1 1;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.ultraviewdemo.client.SmallHostControlController">

    <effect>
        <DropShadow color="#00000033" offsetX="-2.0" radius="10.0" />
    </effect>

    <padding>
        <Insets bottom="15.0" left="10.0" right="5.0" top="15.0" />
    </padding>

    <Button fx:id="toggleMenuBtn" text="⟩"
            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-weight: bold; -fx-cursor: hand;">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <VBox fx:id="menuPane" alignment="CENTER" spacing="12.0">

        <Label fx:id="statusLabel" text="Sharing" textAlignment="CENTER" wrapText="true"
               style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 10px;">
            <VBox.margin>
                <Insets bottom="5.0" />
            </VBox.margin>
        </Label>

        <Button fx:id="chatBtn" text="💬 Chat" prefWidth="90.0"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>

<!--        <Button fx:id="audioBtn" text="🎤 Audio" prefWidth="90.0"-->
<!--                style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-cursor: hand;"/>-->

        <VBox prefHeight="10.0" />

        <Button fx:id="stopBtn" text="STOP" prefWidth="90.0"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </VBox>

</VBox>